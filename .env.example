# Copy this to backend/.env for local use, or set these as environment
# variables in your hosting provider (Railway → Variables tab). None are
# required to run NSEMAS locally or in a demo deployment — sensible
# defaults are used — but JWT_SECRET should always be set for anything
# beyond local testing.

# ---- Core ----
PORT=4000
NODE_ENV=production

# REQUIRED for any real deployment: a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins if you deploy the
# frontend separately (e.g. on Vercel) from this API (e.g. on Railway).
# Leave unset to allow any origin (fine for a demo; a bearer-token API
# like this one doesn't carry the CSRF risk cookie-based auth would).
# Example: CORS_ORIGIN=https://nsemas.vercel.app,https://nsemas-demo.vercel.app
CORS_ORIGIN=

# ---- Encryption at rest (optional) ----
# Set to "true" to encrypt every JSON data file on disk (AES-256-GCM).
NSEMAS_ENCRYPT_AT_REST=false
# 64-character hex string (32 bytes). If unset while encryption is on, a
# key is auto-generated into backend/data/.encryption-key — make sure that
# path is on a persistent volume, or encrypted data becomes unreadable on
# the next deploy. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---- Real email delivery (optional) ----
# Without these, email "sends" are logged to the Comms Outbox instead of
# actually delivered — see README "What's simulated".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@nsemas.gov.gh

# ---- Real SMS delivery (optional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
